# Copy to .env and fill in values from your hosting control panel.
# NEVER commit .env to git.

# --- Local XAMPP ---
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=garbage_tracker

# --- Remote (InfinityFree / ByetCluster / similar) ---
DB_HOST=sqlXXX.byetcluster.com
DB_USER=your_mysql_username
DB_PASS=your_mysql_password
DB_NAME=your_database_name
