# Block access to sensitive files (Apache)
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<Files "setup_db.php">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Optional: force HTTPS when your host supports SSL
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
